{
  "name": "coinvy",
  "version": "2.0.0",
  "description": "COINVY — Inteligência para cuidar do seu dinheiro.",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,green.bold\" \"npx tsx watch server/index.ts\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npx tsx server/index.ts",
    "server": "npx tsx watch server/index.ts",
    "client": "npm run dev --prefix client"
  },
  "keywords": [
    "financas",
    "controle-financeiro",
    "monefy",
    "gestor-financeiro",
    "coinvy",
    "orcamento",
    "react",
    "sqlite"
  ],
  "author": "COINVY",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
